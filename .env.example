DATABASE_URL="postgresql://postgres:password@localhost:5432/commerce_analyze?schema=public"
REDIS_URL="redis://localhost:6379"

# Entysa panel auth.
# Register yoktur; panel bu tek kullanıcıyla açılır.
AUTH_SECRET="replace-with-a-long-random-secret"
ENTYSA_ADMIN_EMAIL="admin@entysa.local"
ENTYSA_ADMIN_PASSWORD="change-me"

# Dummy worker pacing in milliseconds.
AUDIT_STATUS_STEP_DELAY_MS=800

# Phase 2 crawler defaults.
CRAWLER_TIMEOUT_MS=45000
CRAWLER_MAX_TEXT_LENGTH=20000
CRAWLER_MAX_PAGES=10
CRAWLER_MAX_REDIRECTS=5
LOCAL_STORAGE_ROOT="public/storage"
LOCAL_STORAGE_PUBLIC_URL_PREFIX="/storage"
SCREENSHOT_MAX_BYTES=4000000

# Phase 5 technical audit defaults.
LIGHTHOUSE_TIMEOUT_MS=60000
ACCESSIBILITY_TIMEOUT_MS=45000

# Phase 8 AI provider.
# Leave OPENAI_API_KEY empty to use the local structured fallback during development.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4.1-mini"
AI_TIMEOUT_MS=60000
AI_MAX_PROMPT_CHARS=60000
AI_MAX_STRING_CHARS=4000
AI_MAX_ARRAY_ITEMS=80

# Phase 12 production guards.
RATE_LIMIT_WINDOW_MS=60000
AUDIT_CREATE_RATE_LIMIT_MAX=10
AUDIT_START_RATE_LIMIT_MAX=20
ADMIN_API_KEY=""
